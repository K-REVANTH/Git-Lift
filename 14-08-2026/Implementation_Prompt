─── BEDROCK TITAN HELPER ─────────────────────────────────────────────

def call_bedrock_titan(text: str) -> list:
    """Call AWS Bedrock Titan Embeddings v1 and return embedding vector."""
    client = boto3.client(
        "bedrock-runtime",
        region_name=os.environ.get("AWS_DEFAULT_REGION", "us-east-1")
    )
    response = client.invoke_model(
        modelId="amazon.titan-embed-text-v1",
        body=json.dumps({"inputText": text[:8000]}),
        contentType="application/json",
        accept="application/json"
    )
    result = json.loads(response["body"].read())
    return result["embedding"]

When --skip-embeddings flag is passed:
  Skip all embedding generation.
  Leave embedding columns as NULL.
  This allows seeding to run without AWS credentials.

