  "default_branch", "web_url", "avatar_url", "forks_count",
  "star_count", "open_issues_count", "size", "repository_size"

─── COLUMN STATS ─────────────────────────────────────────────────────

For each CSV column (mapped or unmapped):
  column_stats[col] = {
    "non_zero_count": <int>,
    "total_value": <numeric sum or 0 for non-numeric>,
    "sample_values": <first 3 non-zero/non-empty values>
  }

─── OUTPUT (must be the ONLY print statement) ────────────────────────

print(json.dumps({
  "source_platform": source_platform,
  "platform_confidence": platform_confidence,
  "platform_evidence": platform_evidence,
  "total_repos": total_repos,
  "usage_signals": usage_signals,
